# Copia este archivo como .env y completa tus datos. El .env NO se sube a GitHub.

# --- Base de datos ---
# Sin DB_URL se usa la base de demostración (ventas_demo.db).
# DB_URL=mssql+pyodbc://sa:TuPassword@localhost:1433/VentasDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- Correo (solo si usas --enviar) ---
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=tu_correo@gmail.com
SMTP_CONTRASENA=tu_contraseña_de_aplicación
CORREO_DESTINO=destinatario@ejemplo.com
# CORREO_REMITENTE=Reportes <tu_correo@gmail.com>
